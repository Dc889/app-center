{
  "openapi": "3.0.3",
  "info": {
    "title": "agent 只读目录",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/internal/v1"
    }
  ],
  "security": [
    {
      "serviceToken": []
    }
  ],
  "components": {
    "securitySchemes": {
      "serviceToken": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/agents": {
      "get": {
        "parameters": [],
        "responses": {
          "200": {
            "description": "当前条目",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "nextCursor": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "服务身份无效"
          },
          "404": {
            "description": "记录不可见"
          }
        }
      }
    },
    "/agents/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "单个条目",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "服务身份无效"
          },
          "404": {
            "description": "记录不可见"
          }
        }
      }
    }
  }
}
