{
  "openapi": "3.0.3",
  "info": {
    "title": "插件样例包仓库",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/internal/v1"
    }
  ],
  "security": [
    {
      "serviceToken": []
    }
  ],
  "components": {
    "securitySchemes": {
      "serviceToken": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/plugins/document-parser/versions/v2.4.1": {
      "get": {
        "parameters": [],
        "responses": {
          "200": {
            "description": "样例包元数据",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "resourceId",
                    "version",
                    "sha256",
                    "sizeBytes"
                  ],
                  "properties": {
                    "resourceId": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string"
                    },
                    "sizeBytes": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "服务身份无效"
          },
          "404": {
            "description": "记录不可见"
          }
        }
      }
    },
    "/plugins/document-parser/versions/v2.4.1/file": {
      "get": {
        "parameters": [],
        "responses": {
          "200": {
            "description": "原始字节",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "403": {
            "description": "服务身份无效"
          },
          "404": {
            "description": "记录不可见"
          }
        }
      }
    }
  }
}
