# 镜像 3：app-center-repositories（四大自建仓库：skill / plugin / mcp / agent，零外部子系统耦合）
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0

COPY package.json ./
COPY --from=deps /app/node_modules ./node_modules
COPY runtime ./runtime
COPY contracts ./contracts
COPY capability/platform/catalog ./capability/platform/catalog
COPY capability/repositories ./capability/repositories
COPY server/lifecycle.mjs server/start-repository.mjs ./server/

RUN mkdir -p /data/skill /data/plugin /data/mcp /data/agent
EXPOSE 4311 4312 4313 4314
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4311)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server/start-repository.mjs"]
