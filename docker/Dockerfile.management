# 镜像 2：app-center-management（管理系统后端，仅含服务端依赖，物理隔离前端/能力层/连接器）
FROM node:22-alpine AS deps
WORKDIR /app
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=4300 \
    APP_DATA_DIR=/data/management \
    TRUST_PROXY=1

COPY server/package.json ./package.json
COPY --from=deps /app/node_modules ./node_modules
COPY runtime ./runtime
COPY contracts ./contracts
COPY management ./management
COPY server/lifecycle.mjs server/start-management.mjs ./server/

# 移除仅用于前端构建的 TSX/CSS/web 目录，保持后端镜像纯净
RUN rm -rf management/shared-ui management/app/web management/modules/*/web management/platform/*/web \
    && find management -name '*.ts' -o -name '*.tsx' -o -name '*.css' | xargs rm -f \
    && mkdir -p /data/management

EXPOSE 4300
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:4300/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server/start-management.mjs"]
