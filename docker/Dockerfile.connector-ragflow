# 镜像 6：app-center-connector-ragflow（独立 RAGFlow 适配服务，无状态，可随 RAGFlow 0.22.1 -> 新版独立升级发版）
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=4322 \
    RAGFLOW_ADAPTER_VERSION=0.22.1

COPY package.json ./
COPY runtime/http.mjs runtime/mysql-ledger.mjs runtime/mysql-worker.mjs ./runtime/
COPY connectors/ragflow ./connectors/ragflow
COPY server/lifecycle.mjs server/start-connector-ragflow.mjs ./server/

EXPOSE 4322
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4322/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server/start-connector-ragflow.mjs"]
