# AI 运营管理平台（app-center）Docker 部署配置模板
# 复制为 docker/.env 后填入真实内网地址与密钥，切勿提交真实 .env 至代码仓库

# ---- 镜像版本标签（可按子系统独立升级） ----
APP_VERSION=1.0.0
DIFY_CONNECTOR_TAG=1.7.1
RAGFLOW_CONNECTOR_TAG=0.22.1
APP_CENTER_PORT=8088

# ---- 服务间内部鉴权令牌（生产请使用 32+ 字节随机密钥） ----
INTERNAL_TOKEN=replace-with-strong-random-internal-token

# ---- MySQL 8.0 宿主机本地回环端口与口令（修改口令后需同步更新 docker/mysql/init.sql） ----
MYSQL_HOST_PORT=13306
MYSQL_ROOT_PASSWORD=ac_root_change_me
MYSQL_MGMT_PASSWORD=ac_mgmt_change_me
MYSQL_EXEC_PASSWORD=ac_exec_change_me
MYSQL_REPO_PASSWORD=ac_repo_change_me

# ---- 能力执行器严格模式 ----
CAPABILITY_STRICT_UPSTREAM=1
DIFY_INSTALL_ACCOUNT=chen.yu

# ---- 仅注入 connector-dify 容器（executor / management 均不可见） ----
DIFY_ADAPTER_VERSION=1.7.1
DIFY_API_BASE=http://host.docker.internal:8080
DIFY_CONSOLE_TOKEN=
DIFY_CONSOLE_EMAIL=
DIFY_CONSOLE_PASSWORD=
DIFY_WORKSPACE_ID=
DIFY_PLUGIN_DAEMON_BASE=
DIFY_PLUGIN_DAEMON_KEY=
DIFY_OWNER_ACCOUNT_MAP={}

# ---- 仅注入 connector-ragflow 容器（executor / management 均不可见） ----
RAGFLOW_ADAPTER_VERSION=0.22.1
RAGFLOW_API_BASE=http://host.docker.internal:9380
RAGFLOW_API_KEY=
RAGFLOW_TENANT_ID=
RAGFLOW_EXTERNAL_ENDPOINT=http://host.docker.internal:9380/api/v1/dify
RAGFLOW_OWNER_ACCOUNT_MAP={}
