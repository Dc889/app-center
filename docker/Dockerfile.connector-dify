# 镜像 5：app-center-connector-dify（独立 Dify 适配服务，无状态，可随 Dify 1.7.1 -> 1.14.0 独立升级发版）
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=4321 \
    DIFY_ADAPTER_VERSION=1.7.1

COPY package.json ./
COPY runtime/http.mjs runtime/mysql-ledger.mjs runtime/mysql-worker.mjs ./runtime/
COPY connectors/dify ./connectors/dify
COPY server/lifecycle.mjs server/start-connector-dify.mjs ./server/

EXPOSE 4321
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4321/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server/start-connector-dify.mjs"]
